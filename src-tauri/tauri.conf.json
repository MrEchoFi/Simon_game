{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retro Simon",
  "version": "1.0.0",
  "identifier": "com.retroarcadelab.simongame",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Retro Simon",
        "width": 980,
        "height": 1050,
        "minWidth": 640,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
